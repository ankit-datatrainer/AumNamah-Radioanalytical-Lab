Options -Indexes

# ---- Security: never serve backups, database dumps, dev scripts or repo files ----
<FilesMatch "\.(sql|zip|rar|7z|tar|gz|bak|old|orig|log|bat|sh|ini|env|md|git.*)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(router\.php|start-local\.bat|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files/folders (.git, .env ...) and the database/ folder
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^database(/|$) - [F,L,NC]

    # Never execute PHP (or other scripts) anywhere under assets/ — only api/*.php runs
    RewriteRule ^assets/.*\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|shtml|html?|svg)$ - [F,L,NC]

    # /blog/<slug> -> Blog-Post.html?slug=<slug>  (internal rewrite, URL bar keeps /blog/<slug>)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ Blog-Post.html?slug=$1 [L,QSA,NC]

    # /blog and /blog/ -> Blog.html (blog listing page)
    RewriteRule ^blog/?$ Blog.html [L,NC]
</IfModule>

# Keep the admin panel out of search results
<FilesMatch "^Admin-(Login|Dashboard)\.html$">
    <IfModule mod_headers.c>
        Header set X-Robots-Tag "noindex, nofollow"
    </IfModule>
</FilesMatch>
